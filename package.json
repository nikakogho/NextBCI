{
  "name": "nextbci",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run generate:map-data",
    "dev": "next dev -p 3100",
    "generate:world": "node scripts/generate-world.mjs",
    "generate:map-data": "node scripts/generate-map-data.mjs",
    "generate:africa-south-america": "node scripts/generate-africa-south-america-expansion.mjs",
    "audit:africa-south-america": "node scripts/audit-africa-south-america-links.mjs",
    "research:top-company-milestones": "node scripts/research-top-company-milestones.mjs",
    "generate:top-company-audit": "node scripts/generate-top-company-milestone-audit.mjs",
    "enrich:sourced-companies": "node scripts/enrich-sourced-company-profiles.mjs",
    "audit:sourced-links": "node scripts/audit-sourced-links.mjs",
    "build": "npm run generate:world && npm run generate:map-data && npm run validate:data && next build",
    "start": "next start -p 3100",
    "validate:data": "node scripts/validate-data.mjs && node scripts/validate-company-research.mjs && node scripts/validate-sourced-expansion.mjs && node scripts/validate-africa-south-america-expansion.mjs && node scripts/validate-top-company-milestones.mjs",
    "test:data": "node scripts/test-data-queries.mjs",
    "check:build-size": "node scripts/check-build-size.mjs",
    "ci": "npm run validate:data && npm run test:data && npm run lint && npm run typecheck && npm run build && npm run check:build-size",
    "benchmark:routes": "node scripts/benchmark-routes.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.15.33",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "4.3.1",
    "topojson-client": "^3.1.0",
    "typescript": "6.0.3"
  }
}
