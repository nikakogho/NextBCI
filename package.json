{
  "name": "nextbci",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:world": "node scripts/generate-world.mjs",
    "build": "npm run generate:world && npm run validate:data && next build",
    "start": "next start",
    "validate:data": "node scripts/validate-data.mjs",
    "test:data": "node scripts/test-data-queries.mjs",
    "ci": "npm run validate:data && npm run test:data && npm run lint && npm run typecheck && npm run build",
    "benchmark:routes": "node scripts/benchmark-routes.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.15.33",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "4.3.1",
    "topojson-client": "^3.1.0",
    "typescript": "6.0.3"
  }
}
